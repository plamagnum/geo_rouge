# Copy this file to .env and replace both password placeholders before starting Docker.
# For an existing database, run this migration once before using the updated game:
# docker compose exec -T mysql sh -c 'exec mysql -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE"' < docker/mysql/migrations/001_pending_event.sql
HTTP_PORT=8080
MYSQL_PORT=33061
DB_HOST=mysql
DB_NAME=geo_roguelike
DB_USER=geo_user
DB_PASS=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# Адмінпанель вимкнена без коректного хешу; типового пароля немає.
# Згенеруйте хеш інтерактивно (пароль не потрапить до історії команд):
# docker compose exec php php -r 'system("stty -echo"); try { fwrite(STDOUT, "Пароль: "); $p = rtrim(fgets(STDIN), "\r\n"); } finally { system("stty echo"); } echo PHP_EOL, password_hash($p, PASSWORD_DEFAULT), PHP_EOL;'
# Вставте отриманий хеш у .env В ОДИНАРНИХ ЛАПКАХ, щоб зберегти символи $:
# ADMIN_PASSWORD_HASH='$2y$...повний_хеш...'
ADMIN_PASSWORD_HASH=''
# Застосуйте зміну: docker compose up -d --force-recreate php
# Після оновлення nginx-конфігурації: docker compose restart nginx
# У production обов’язковий HTTPS. За довіреним TLS-проксі налаштуйте HTTPS
# для FastCGI на сервері; не довіряйте довільному клієнтському X-Forwarded-Proto.
# nginx обмежує ВСІ POST адмінпанелі: 5/хв на IP, початковий burst 5 (HTTP 429).
# За проксі налаштуйте real_ip лише для довірених адрес, інакше ліміт спільний.
