# Copy this file to .env and replace both password placeholders before starting Docker.
# For an existing database, run this migration once before using the updated game:
# docker compose exec -T mysql sh -c 'exec mysql -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE"' < docker/mysql/migrations/001_pending_event.sql
HTTP_PORT=8080
MYSQL_PORT=33061
DB_HOST=mysql
DB_NAME=geo_roguelike
DB_USER=geo_user
DB_PASS=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
